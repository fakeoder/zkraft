{
  "name": "zkraft-landing",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Landing page for zkraft.cc — Vite + Hono on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "icons": "pwa-assets-generator",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zkraft --local",
    "db:migrate:remote": "wrangler d1 migrations apply zkraft --remote"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.123.0"
  }
}
